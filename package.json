{
  "name": "dsh-plugin-steward",
  "version": "1.0.0",
  "type": "module",
  "description": "Plugin steward for DeepSeek Harness: update checks, auto-update with snapshot rollback, health checks, duplicate analysis, cleanup — one left-panel UI and one CLI. · 插件管家：查更新、有新版本自动装（装前备份、出错回滚）、体检、查重、清垃圾。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin-manager",
    "plugin-updater",
    "auto-update",
    "cordis"
  ],
  "license": "MIT",
  "author": "智初",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "dsh-pm": "bin/dsh-pm.mjs",
    "dsh-plugin-steward": "bin/dsh-pm.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "src/*.mjs",
    "bin/dsh-pm.mjs"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lihao178/dsh-plugin-steward"
  },
  "homepage": "https://github.com/lihao178/dsh-plugin-steward#readme"
}
